+func TestMieruUDPAssociationUsesOneUserScopedLinkForMultipleTargets(t *testing.T) {
+	captures := make(chan udpAssociationCapture, 4)
+	responses := &udpAssociationResponseReader{ch: make(chan buf.MultiBuffer, 2)}
+	dispatcher := &udpAssociationDispatcher{link: &transport.Link{
+		Reader: responses,
+		Writer: &udpAssociationCaptureWriter{ch: captures},
+	}}
+	ctx := session.ContextWithInbound(context.Background(), &session.Inbound{
+		User: &protocol.MemoryUser{Email: "alice@example"},
+	})
+	association := newMieruUDPAssociation(ctx, dispatcher, time.Minute)
+
+	targets := []xnet.Destination{
+		xnet.UDPDestination(xnet.ParseAddress("127.0.0.1"), 5301),
+		xnet.UDPDestination(xnet.ParseAddress("127.0.0.2"), 5302),
+	}
+	var stream []byte
+	for i, target := range targets {
+		datagram, err := encodeSocks5UDPDatagram(target, []byte{byte('a' + i)})
+		if err != nil {
+			t.Fatal(err)
+		}
+		frame, err := encodeMieruUDPFrame(datagram)
+		if err != nil {
+			t.Fatal(err)
+		}
+		stream = append(stream, frame...)
+	}
+	for _, chunk := range [][]byte{stream[:2], stream[2:17], stream[17:]} {
+		if err := association.Writer.WriteMultiBuffer(bytesToMultiBuffer(chunk)); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	for i, target := range targets {
+		select {
+		case got := <-captures:
+			if got.destination != target.NetAddr() || got.payload != string([]byte{byte('a' + i)}) {
+				t.Errorf("capture %d = %+v, want %s", i, got, target.NetAddr())
+			}
+		case <-time.After(2 * time.Second):
+			t.Fatalf("timed out waiting for target %d", i)
+		}
+	}
+	dispatcher.mu.Lock()
+	if dispatcher.calls != 1 || dispatcher.firstDestination != targets[0].NetAddr() || dispatcher.user != "alice@example" {
+		t.Errorf("dispatch calls=%d first=%q user=%q", dispatcher.calls, dispatcher.firstDestination, dispatcher.user)
+	}
+	dispatcher.mu.Unlock()
+
+	source := xnet.UDPDestination(xnet.ParseAddress("192.0.2.10"), 5353)
+	response := buf.New()
+	_, _ = response.Write([]byte("reply"))
+	response.UDP = &source
+	responses.ch <- buf.MultiBuffer{response}
+
+	reader := association.Reader.(buf.TimeoutReader)
+	mb, err := reader.ReadMultiBufferTimeout(2 * time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(mb) == 0 {
+		t.Fatal("timed out waiting for framed response")
+	}
+	responseStream := mbToBytes(mb)
+	decoder := new(mieruUDPFrameDecoder)
+	frames, err := decoder.feed(responseStream)
+	if err != nil || len(frames) != 1 {
+		t.Fatalf("response frames=%d err=%v", len(frames), err)
+	}
+	responseSource, responsePayload, err := parseSocks5UDPDatagram(frames[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer responsePayload.Release()
+	if responseSource.NetAddr() != source.NetAddr() || responsePayload.String() != "reply" {
+		t.Errorf("response source=%s payload=%q", responseSource.NetAddr(), responsePayload.String())
+	}
+
+	associationWriter := association.Writer.(*mieruUDPAssociation)
+	var wg sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			associationWriter.Interrupt()
+		}()
+	}
+	wg.Wait()
+}
