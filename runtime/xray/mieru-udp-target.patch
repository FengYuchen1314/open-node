+func TestMieruUDPFrameSplitAndCoalesced(t *testing.T) {
+	payloads := [][]byte{[]byte("alpha"), bytes.Repeat([]byte{0x42}, 4096), []byte("omega")}
+	var stream []byte
+	for _, payload := range payloads {
+		frame, err := encodeMieruUDPFrame(payload)
+		if err != nil {
+			t.Fatal(err)
+		}
+		stream = append(stream, frame...)
+	}
+
+	decoder := new(mieruUDPFrameDecoder)
+	var got [][]byte
+	for len(stream) > 0 {
+		n := 7
+		if n > len(stream) {
+			n = len(stream)
+		}
+		frames, err := decoder.feed(stream[:n])
+		if err != nil {
+			t.Fatal(err)
+		}
+		got = append(got, frames...)
+		stream = stream[n:]
+	}
+	if err := decoder.finish(); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != len(payloads) {
+		t.Fatalf("decoded %d frames, want %d", len(got), len(payloads))
+	}
+	for i := range got {
+		if !bytes.Equal(got[i], payloads[i]) {
+			t.Errorf("frame %d payload mismatch", i)
+		}
+	}
+}
