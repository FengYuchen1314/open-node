+func TestMieruUDPAssociationClosesBeforeFirstPacketDeadline(t *testing.T) {
+	dispatcher := &udpAssociationDispatcher{}
+	association := newMieruUDPAssociation(context.Background(), dispatcher, 10*time.Millisecond)
+	reader := association.Reader.(buf.TimeoutReader)
+	if mb, err := reader.ReadMultiBufferTimeout(time.Second); err != io.EOF {
+		buf.ReleaseMulti(mb)
+		t.Fatalf("deadline read error = %v, want EOF", err)
+	}
+	dispatcher.mu.Lock()
+	defer dispatcher.mu.Unlock()
+	if dispatcher.calls != 0 {
+		t.Fatalf("dispatch calls = %d, want 0", dispatcher.calls)
+	}
