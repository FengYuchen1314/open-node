+func TestMieruUDPAssociationDropsFragmentAndContinues(t *testing.T) {
+	captures := make(chan udpAssociationCapture, 2)
+	responses := &udpAssociationResponseReader{ch: make(chan buf.MultiBuffer)}
+	dispatcher := &udpAssociationDispatcher{link: &transport.Link{
+		Reader: responses,
+		Writer: &udpAssociationCaptureWriter{ch: captures},
+	}}
+	association := newMieruUDPAssociation(context.Background(), dispatcher, time.Minute)
+	defer association.Writer.(*mieruUDPAssociation).Interrupt()
+
+	target := xnet.UDPDestination(xnet.ParseAddress("127.0.0.1"), 5301)
+	datagram, err := encodeSocks5UDPDatagram(target, []byte("accepted"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	fragmented := append([]byte(nil), datagram...)
+	fragmented[2] = 1
+	badFrame, _ := encodeMieruUDPFrame(fragmented)
+	goodFrame, _ := encodeMieruUDPFrame(datagram)
+	if err := association.Writer.WriteMultiBuffer(
+		bytesToMultiBuffer(append(badFrame, goodFrame...)),
+	); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case got := <-captures:
+		if got.destination != target.NetAddr() || got.payload != "accepted" {
+			t.Fatalf("unexpected datagram after fragment: %+v", got)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("valid datagram after fragment was not dispatched")
+	}
+}
+
+type udpAssociationCapture struct {
+	destination string
+	payload     string
+}
+
+type udpAssociationCaptureWriter struct {
+	ch chan udpAssociationCapture
+}
+
+func (w *udpAssociationCaptureWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	for _, payload := range mb {
+		destination := ""
+		if payload.UDP != nil {
+			destination = payload.UDP.NetAddr()
+		}
+		w.ch <- udpAssociationCapture{destination: destination, payload: string(payload.Bytes())}
+	}
+	buf.ReleaseMulti(mb)
+	return nil
+}
+
+type udpAssociationResponseReader struct {
+	ch   chan buf.MultiBuffer
+	once sync.Once
+}
+
+type udpAssociationFinalResponseReader struct {
+	response buf.MultiBuffer
+}
+
+func (r *udpAssociationFinalResponseReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	response := r.response
+	r.response = nil
+	return response, io.EOF
+}
+
+func (*udpAssociationFinalResponseReader) Interrupt() {}
+
+func (r *udpAssociationResponseReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	mb, ok := <-r.ch
+	if !ok {
+		return nil, io.EOF
+	}
+	return mb, nil
+}
+
+func (r *udpAssociationResponseReader) Interrupt() {
+	r.once.Do(func() { close(r.ch) })
+}
+
+type udpAssociationDispatcher struct {
+	mu               sync.Mutex
+	calls            int
+	firstDestination string
+	user             string
+	link             *transport.Link
+}
+
+func (*udpAssociationDispatcher) Type() interface{} { return nil }
+func (*udpAssociationDispatcher) Start() error      { return nil }
+func (*udpAssociationDispatcher) Close() error      { return nil }
+
+func (d *udpAssociationDispatcher) Dispatch(ctx context.Context, destination xnet.Destination) (*transport.Link, error) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	d.calls++
+	d.firstDestination = destination.NetAddr()
+	if inbound := session.InboundFromContext(ctx); inbound != nil && inbound.User != nil {
+		d.user = inbound.User.Email
+	}
+	return d.link, nil
+}
+
+func (*udpAssociationDispatcher) DispatchLink(context.Context, xnet.Destination, *transport.Link) error {
+	return nil
+}
