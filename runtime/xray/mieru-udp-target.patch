+func TestSocks5UDPDatagramAddressFamilies(t *testing.T) {
+	tests := []xnet.Destination{
+		xnet.UDPDestination(xnet.ParseAddress("127.0.0.1"), 5301),
+		xnet.UDPDestination(xnet.ParseAddress("dns.example"), 5302),
+		xnet.UDPDestination(xnet.ParseAddress("2001:db8::1"), 5303),
+	}
+	for _, source := range tests {
+		t.Run(source.NetAddr(), func(t *testing.T) {
+			datagram, err := encodeSocks5UDPDatagram(source, []byte("packet"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			destination, payload, err := parseSocks5UDPDatagram(datagram)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer payload.Release()
+			if destination.NetAddr() != source.NetAddr() || destination.Network != xnet.Network_UDP {
+				t.Errorf("destination = %s, want %s", destination, source)
+			}
+			if payload.UDP == nil || payload.UDP.NetAddr() != source.NetAddr() {
+				t.Errorf("per-packet destination = %v, want %s", payload.UDP, source.NetAddr())
+			}
+			if string(payload.Bytes()) != "packet" {
+				t.Errorf("payload = %q", payload.String())
+			}
+		})
+	}
+}
