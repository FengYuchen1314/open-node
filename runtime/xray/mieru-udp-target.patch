+func TestMieruUDPAssociationDeliversFinalResponseWithEOF(t *testing.T) {
+	source := xnet.UDPDestination(xnet.ParseAddress("192.0.2.20"), 5353)
+	response := buf.New()
+	_, _ = response.Write([]byte("final"))
+	response.UDP = &source
+	dispatcher := &udpAssociationDispatcher{link: &transport.Link{
+		Reader: &udpAssociationFinalResponseReader{response: buf.MultiBuffer{response}},
+		Writer: &udpAssociationCaptureWriter{ch: make(chan udpAssociationCapture, 1)},
+	}}
+	association := newMieruUDPAssociation(context.Background(), dispatcher, time.Minute)
+	target := xnet.UDPDestination(xnet.ParseAddress("127.0.0.1"), 5301)
+	datagram, _ := encodeSocks5UDPDatagram(target, []byte("request"))
+	frame, _ := encodeMieruUDPFrame(datagram)
+	if err := association.Writer.WriteMultiBuffer(bytesToMultiBuffer(frame)); err != nil {
+		t.Fatal(err)
+	}
+	reader := association.Reader.(buf.TimeoutReader)
+	mb, err := reader.ReadMultiBufferTimeout(2 * time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	frames, err := new(mieruUDPFrameDecoder).feed(mbToBytes(mb))
+	if err != nil || len(frames) != 1 {
+		t.Fatalf("frames=%d err=%v", len(frames), err)
+	}
+	gotSource, payload, err := parseSocks5UDPDatagram(frames[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer payload.Release()
+	if gotSource.NetAddr() != source.NetAddr() || payload.String() != "final" {
+		t.Fatalf("source=%s payload=%q", gotSource.NetAddr(), payload.String())
+	}
+}
