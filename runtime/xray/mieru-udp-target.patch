diff --git a/proxy/mieru/udp_target.go b/proxy/mieru/udp_target.go
new file mode 100644
index 0000000..464deb5
--- /dev/null
+++ b/proxy/mieru/udp_target.go
@@ -0,0 +1,366 @@
+// SPDX-License-Identifier: MPL-2.0
+
+package mieru
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"io"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+const (
+	mieruUDPFrameStart = 0x00
+	mieruUDPFrameEnd   = 0xff
+
+	// Xray's native UDP paths use one regular buffer per datagram. Keeping the
+	// complete SOCKS5 datagram within that limit prevents a single UDP packet
+	// from being split into several independent writes by downstream code.
+	maxMieruUDPFrameData = buf.Size
+
+	// A SOCKS client must send its first UDP datagram promptly after the
+	// association reply. Bound sessions that have not reached the dispatcher,
+	// where the normal idle timer and native admission limits take over.
+	maxMieruUDPActivationTimeout = time.Minute
+)
+
+var mieruUDPAddressParser = protocol.NewAddressParser(
+	protocol.AddressFamilyByte(socks5ATYPIPv4, xnet.AddressFamilyIPv4),
+	protocol.AddressFamilyByte(socks5ATYPIPv6, xnet.AddressFamilyIPv6),
+	protocol.AddressFamilyByte(socks5ATYPDomain, xnet.AddressFamilyDomain),
+)
+
+// mieruUDPFrameDecoder restores the packet boundaries defined by the public
+// mieru UDP-associate encapsulation. The byte stream can be split or coalesced
+// at arbitrary Mieru segment boundaries.
+type mieruUDPFrameDecoder struct {
+	pending []byte
+}
+
+func (d *mieruUDPFrameDecoder) feed(chunk []byte) ([][]byte, error) {
+	d.pending = append(d.pending, chunk...)
+	var frames [][]byte
+	offset := 0
+	for len(d.pending)-offset > 0 {
+		remaining := d.pending[offset:]
+		if remaining[0] != mieruUDPFrameStart {
+			return nil, errors.New("mieru: invalid UDP frame start marker")
+		}
+		if len(remaining) < 3 {
+			break
+		}
+		length := int(binary.BigEndian.Uint16(remaining[1:3]))
+		if length == 0 {
+			return nil, errors.New("mieru: empty UDP frame")
+		}
+		if length > maxMieruUDPFrameData {
+			return nil, errors.New("mieru: UDP frame exceeds runtime datagram limit")
+		}
+		total := 3 + length + 1
+		if len(remaining) < total {
+			break
+		}
+		if remaining[total-1] != mieruUDPFrameEnd {
+			return nil, errors.New("mieru: invalid UDP frame end marker")
+		}
+		frame := make([]byte, length)
+		copy(frame, remaining[3:3+length])
+		frames = append(frames, frame)
+		offset += total
+	}
+	if offset > 0 {
+		copy(d.pending, d.pending[offset:])
+		d.pending = d.pending[:len(d.pending)-offset]
+	}
+	if len(d.pending) > maxMieruUDPFrameData+4 {
+		return nil, errors.New("mieru: incomplete UDP frame exceeds runtime datagram limit")
+	}
+	return frames, nil
+}
+
+func (d *mieruUDPFrameDecoder) finish() error {
+	if len(d.pending) != 0 {
+		return errors.New("mieru: truncated UDP frame")
+	}
+	return nil
+}
+
+func encodeMieruUDPFrame(datagram []byte) ([]byte, error) {
+	if len(datagram) == 0 {
+		return nil, errors.New("mieru: cannot encode an empty UDP frame")
+	}
+	if len(datagram) > maxMieruUDPFrameData {
+		return nil, errors.New("mieru: UDP frame exceeds runtime datagram limit")
+	}
+	frame := make([]byte, 3+len(datagram)+1)
+	frame[0] = mieruUDPFrameStart
+	binary.BigEndian.PutUint16(frame[1:3], uint16(len(datagram)))
+	copy(frame[3:], datagram)
+	frame[len(frame)-1] = mieruUDPFrameEnd
+	return frame, nil
+}
+
+// parseSocks5UDPDatagram parses RFC 1928's UDP request header. Fragmentation is
+// deliberately unsupported, matching Xray's native SOCKS implementation.
+func parseSocks5UDPDatagram(datagram []byte) (xnet.Destination, *buf.Buffer, error) {
+	var destination xnet.Destination
+	if len(datagram) < 4 {
+		return destination, nil, errors.New("mieru: short SOCKS5 UDP datagram")
+	}
+	if datagram[0] != 0 || datagram[1] != 0 {
+		return destination, nil, errors.New("mieru: invalid SOCKS5 UDP reserved field")
+	}
+	if datagram[2] != 0 {
+		return destination, nil, errors.New("mieru: fragmented SOCKS5 UDP datagram is unsupported")
+	}
+	switch datagram[3] {
+	case socks5ATYPIPv4, socks5ATYPIPv6:
+	case socks5ATYPDomain:
+		// The shared address parser assumes a non-empty domain and indexes its
+		// first byte. Reject the untrusted zero-length form before handing it
+		// to that parser.
+		if len(datagram) < 5 || datagram[4] == 0 {
+			return destination, nil, errors.New("mieru: empty SOCKS5 UDP domain")
+		}
+	default:
+		return destination, nil, errors.New("mieru: unknown SOCKS5 UDP address type")
+	}
+
+	reader := bytes.NewReader(datagram[3:])
+	address, port, err := mieruUDPAddressParser.ReadAddressPort(nil, reader)
+	if err != nil {
+		return destination, nil, errors.New("mieru: invalid SOCKS5 UDP destination").Base(err)
+	}
+	if address == nil || address.String() == "" || port == 0 {
+		return destination, nil, errors.New("mieru: empty SOCKS5 UDP destination")
+	}
+	destination = xnet.UDPDestination(address, port)
+	payloadOffset := len(datagram) - reader.Len()
+	payloadSize := len(datagram) - payloadOffset
+	allocation := payloadSize
+	if allocation == 0 {
+		allocation = 1
+	}
+	payload := buf.NewWithSize(int32(allocation))
+	if _, err := payload.Write(datagram[payloadOffset:]); err != nil {
+		payload.Release()
+		return destination, nil, errors.New("mieru: copy SOCKS5 UDP payload").Base(err)
+	}
+	destCopy := destination
+	payload.UDP = &destCopy
+	return destination, payload, nil
+}
+
+func encodeSocks5UDPDatagram(source xnet.Destination, payload []byte) ([]byte, error) {
+	if source.Network != xnet.Network_UDP || source.Address == nil || source.Address.String() == "" || source.Port == 0 {
+		return nil, errors.New("mieru: invalid SOCKS5 UDP response source")
+	}
+	datagram := buf.NewWithSize(maxMieruUDPFrameData)
+	defer datagram.Release()
+	if _, err := datagram.Write([]byte{0, 0, 0}); err != nil {
+		return nil, err
+	}
+	if err := mieruUDPAddressParser.WriteAddressPort(datagram, source.Address, source.Port); err != nil {
+		return nil, errors.New("mieru: encode SOCKS5 UDP response source").Base(err)
+	}
+	if datagram.Available() < int32(len(payload)) {
+		return nil, errors.New("mieru: SOCKS5 UDP response exceeds runtime datagram limit")
+	}
+	if _, err := datagram.Write(payload); err != nil {
+		return nil, err
+	}
+	result := make([]byte, datagram.Len())
+	copy(result, datagram.Bytes())
+	return result, nil
+}
+
+// mieruUDPAssociation adapts one Mieru logical stream to one Xray UDP
+// dispatcher. The dispatcher opens its single outbound link lazily from the
+// first real packet target; the UDP ASSOCIATE request's bind address is never
+// used as an outbound destination.
+type mieruUDPAssociation struct {
+	ctx            context.Context
+	cancel         context.CancelFunc
+	dispatcher     routing.Dispatcher
+	link           *transport.Link
+	output         *pipe.Writer
+	decoder        mieruUDPFrameDecoder
+	decodeMu       sync.Mutex
+	linkMu         sync.Mutex
+	closeOnce      sync.Once
+	closed         atomic.Bool
+	stopActivation context.CancelFunc
+}
+
+func newMieruUDPAssociation(
+	ctx context.Context,
+	dispatcher routing.Dispatcher,
+	activationTimeout time.Duration,
+) *transport.Link {
+	outputReader, outputWriter := pipe.New(pipe.OptionsFromContext(ctx)...)
+	associationCtx, cancel := context.WithCancel(ctx)
+	association := &mieruUDPAssociation{
+		ctx: associationCtx, cancel: cancel, dispatcher: dispatcher, output: outputWriter,
+	}
+	if activationTimeout <= 0 || activationTimeout > maxMieruUDPActivationTimeout {
+		activationTimeout = maxMieruUDPActivationTimeout
+	}
+	activationCtx, stopActivation := context.WithTimeout(associationCtx, activationTimeout)
+	association.stopActivation = stopActivation
+	go func() {
+		<-activationCtx.Done()
+		if activationCtx.Err() == context.DeadlineExceeded {
+			_ = association.Close()
+		}
+	}()
+	return &transport.Link{Reader: outputReader, Writer: association}
+}
+
+func (a *mieruUDPAssociation) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	defer buf.ReleaseMulti(mb)
+	if a.closed.Load() {
+		return io.ErrClosedPipe
+	}
+
+	a.decodeMu.Lock()
+	defer a.decodeMu.Unlock()
+	for _, input := range mb {
+		frames, err := a.decoder.feed(input.Bytes())
+		if err != nil {
+			_ = a.Close()
+			return err
+		}
+		for _, frame := range frames {
+			destination, payload, err := parseSocks5UDPDatagram(frame)
+			if err != nil {
+				errors.LogDebugInner(a.ctx, err, "mieru: drop invalid SOCKS5 UDP datagram")
+				continue
+			}
+			if payload.IsEmpty() {
+				payload.Release()
+				continue
+			}
+			if err := a.dispatch(destination, payload); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func (a *mieruUDPAssociation) dispatch(destination xnet.Destination, payload *buf.Buffer) error {
+	a.linkMu.Lock()
+	if a.closed.Load() {
+		a.linkMu.Unlock()
+		payload.Release()
+		return io.ErrClosedPipe
+	}
+	if a.link == nil {
+		link, err := a.dispatcher.Dispatch(a.ctx, destination)
+		if err != nil {
+			a.linkMu.Unlock()
+			payload.Release()
+			_ = a.Close()
+			return errors.New("mieru: UDP dispatcher failed").Base(err)
+		}
+		if a.closed.Load() {
+			a.linkMu.Unlock()
+			payload.Release()
+			common.Interrupt(link.Reader)
+			common.Interrupt(link.Writer)
+			return io.ErrClosedPipe
+		}
+		a.link = link
+		if a.stopActivation != nil {
+			a.stopActivation()
+		}
+		go a.pumpResponses(destination, link)
+	}
+	link := a.link
+	a.linkMu.Unlock()
+
+	if err := link.Writer.WriteMultiBuffer(buf.MultiBuffer{payload}); err != nil {
+		_ = a.Close()
+		return errors.New("mieru: write UDP target payload").Base(err)
+	}
+	return nil
+}
+
+func (a *mieruUDPAssociation) pumpResponses(firstDestination xnet.Destination, link *transport.Link) {
+	for {
+		mb, readErr := link.Reader.ReadMultiBuffer()
+		for i, payload := range mb {
+			source := firstDestination
+			if payload.UDP != nil {
+				source = *payload.UDP
+			}
+			datagram, err := encodeSocks5UDPDatagram(source, payload.Bytes())
+			payload.Release()
+			if err != nil {
+				errors.LogWarningInner(a.ctx, err, "mieru: drop invalid UDP response")
+				continue
+			}
+			frame, err := encodeMieruUDPFrame(datagram)
+			if err != nil {
+				errors.LogWarningInner(a.ctx, err, "mieru: drop oversized UDP response")
+				continue
+			}
+			buffer := buf.NewWithSize(int32(len(frame)))
+			_, _ = buffer.Write(frame)
+			if a.closed.Load() {
+				buffer.Release()
+				buf.ReleaseMulti(mb[i+1:])
+				return
+			}
+			// pipe.Writer owns and releases buffer on both success and failure.
+			if err := a.output.WriteMultiBuffer(buf.MultiBuffer{buffer}); err != nil {
+				buf.ReleaseMulti(mb[i+1:])
+				_ = a.Close()
+				return
+			}
+		}
+		if readErr != nil {
+			_ = a.Close()
+			return
+		}
+	}
+}
+
+func (a *mieruUDPAssociation) Close() error {
+	a.closeOnce.Do(func() {
+		a.closed.Store(true)
+		if a.stopActivation != nil {
+			a.stopActivation()
+		}
+		a.cancel()
+		a.linkMu.Lock()
+		link := a.link
+		a.linkMu.Unlock()
+		if link != nil {
+			common.Interrupt(link.Reader)
+			common.Interrupt(link.Writer)
+		}
+		_ = a.output.Close()
+	})
+	return nil
+}
+
+func (a *mieruUDPAssociation) Interrupt() {
+	_ = a.Close()
+}
+
+var _ buf.Writer = (*mieruUDPAssociation)(nil)
+var _ io.Closer = (*mieruUDPAssociation)(nil)
+var _ common.Interruptible = (*mieruUDPAssociation)(nil)
