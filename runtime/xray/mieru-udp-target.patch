+func TestSocks5UDPDatagramRejectsFragmentsAndInvalidHeaders(t *testing.T) {
+	valid, err := encodeSocks5UDPDatagram(xnet.UDPDestination(xnet.ParseAddress("127.0.0.1"), 53), []byte("x"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	tests := [][]byte{
+		{0, 0, 0},
+		{0, 0, 0, socks5ATYPDomain, 0, 0, 53},
+		append([]byte(nil), valid...),
+		append([]byte(nil), valid...),
+		append([]byte(nil), valid...),
+	}
+	tests[2][0] = 1
+	tests[3][2] = 1
+	tests[4][3] = 0x02
+	for i, datagram := range tests {
+		if _, payload, err := parseSocks5UDPDatagram(datagram); err == nil {
+			if payload != nil {
+				payload.Release()
+			}
+			t.Fatalf("invalid datagram %d was accepted", i)
+		}
+	}
+}
