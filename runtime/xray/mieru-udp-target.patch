+func TestMieruUDPFrameRejectsInvalidBoundaries(t *testing.T) {
+	overLimit := maxMieruUDPFrameData + 1
+	tests := []struct {
+		name string
+		data []byte
+	}{
+		{name: "start marker", data: []byte{1}},
+		{name: "zero length", data: []byte{mieruUDPFrameStart, 0, 0}},
+		{name: "oversize", data: []byte{mieruUDPFrameStart, byte(overLimit >> 8), byte(overLimit)}},
+		{name: "end marker", data: []byte{mieruUDPFrameStart, 0, 1, 42, 0}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			decoder := new(mieruUDPFrameDecoder)
+			if _, err := decoder.feed(test.data); err == nil {
+				t.Fatal("expected invalid frame to fail")
+			}
+		})
+	}
+
+	decoder := new(mieruUDPFrameDecoder)
+	if _, err := decoder.feed([]byte{mieruUDPFrameStart, 0}); err != nil {
+		t.Fatal(err)
+	}
+	if err := decoder.finish(); err == nil {
+		t.Fatal("expected truncated frame to fail at stream close")
+	}
+	if _, err := encodeMieruUDPFrame(bytes.Repeat([]byte{1}, maxMieruUDPFrameData+1)); err == nil {
+		t.Fatal("expected oversized outbound frame to fail")
+	}
+}
