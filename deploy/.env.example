# Use a distinct tag per release; record the full source commit in OPEN_NODE_REVISION.
OPEN_NODE_IMAGE_REPOSITORY=open-node
OPEN_NODE_IMAGE_TAG=local
OPEN_NODE_REVISION=unknown
OPEN_NODE_BIND_ADDRESS=127.0.0.1
OPEN_NODE_HTTP_PORT=8080
OPEN_NODE_SESSION_COOKIE_SECURE=true
# Keep public generated/custom and legacy /x bearer aliases disabled in production.
OPEN_NODE_SHORT_LINKS_ENABLED=false
# Exact host proxy address as seen by the container, usually its bridge gateway.
# Leave empty until the HTTPS reverse proxy is configured. Never use * here.
OPEN_NODE_TRUSTED_PROXIES=
# Optional legacy Agent signing seed. Create/import it before setting this path.
OPEN_NODE_AGENT_IDENTITY_FILE=
# Optional private Fernet key for administrator/subscriber MFA; keep a backup.
OPEN_NODE_SUBSCRIBER_TOTP_KEY=
# Enable panel-issued Agent installation commands only after configuring HTTPS.
# Use the canonical control-plane URL (not a public Probe Worker URL).
# New Debian 12 amd64 Agent hosts require outbound access to this URL and GitHub.
OPEN_NODE_AGENT_BOOTSTRAP_PUBLIC_URL=
