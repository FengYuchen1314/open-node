{
	admin off
	auto_https disable_redirects
}

https://{$OPEN_NODE_PUBLIC_IP_AUTHORITY}:{$OPEN_NODE_PUBLIC_HTTPS_PORT} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
			disable_http_challenge
		}
	}

	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}

	reverse_proxy 127.0.0.1:{$OPEN_NODE_UPSTREAM_PORT} {
		header_up X-Real-IP {remote_host}
		health_uri /healthz
		health_interval 30s
	}
}
