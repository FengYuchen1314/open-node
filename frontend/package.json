{
  "name": "open-node-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:probe": "tsc -b && vite build --config vite.probe.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "preview:probe": "vite preview --config vite.probe.config.ts --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "antd": "6.6.2",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
