{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-node-probe-worker",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
